# LLM
ANTHROPIC_API_KEY=

# Image generation
OPENAI_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Social posting — direct platform APIs. Leave unset for now and Step 4 will mark
# posts pending_credentials (the pipeline still runs end-to-end). See README.md for
# the manual dashboard steps (Meta Developer App / TikTok Developer App registration,
# scopes, and review/audit process) required before real posting works.

# Meta (Facebook Login for Business) — covers both Facebook Page and Instagram posting
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/social/callback/facebook
# From the app dashboard: Facebook Login for Business > Configurations > Create configuration.
# Required — the OAuth dialog is invoked with this instead of a raw scope list.
META_LOGIN_CONFIG_ID=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/social/callback/tiktok

# Encrypts stored account tokens at rest. Required before any account can be connected.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Where the OAuth callback redirects the browser back to after connecting an account
FRONTEND_URL=http://localhost:3000

# Video generation (Step 2, video campaigns) — image-to-video via Luma's Ray model
# (Luma Agents API). API key from platform.lumalabs.ai (prefixed "luma-api-").
# Leave unset and video campaigns still ideate/review normally, but each variant's
# generation fails cleanly (generation_status = 'failed') instead of crashing.
LUMA_API_KEY=

# Audio (voiceover + background music) for video variants — opt-in per campaign
# ("Add voiceover + background music" checkbox at intake). Voiceover reuses
# OPENAI_API_KEY above (gpt-4o-mini-tts, no new account needed). Music needs a
# separate ElevenLabs key from elevenlabs.io. Leave ELEVENLABS_API_KEY unset and
# voiceover still generates, just without a music bed. Mixing/muxing the two
# together onto the video ALSO requires the `ffmpeg` binary installed and on
# PATH (a system dependency, not a pip package — e.g. `winget install ffmpeg` on
# Windows) — without it, a video variant still generates, just silently without
# audio (variants.audio_gen_error records why).
ELEVENLABS_API_KEY=

# Postgres connection string for the durable job store (24hr feedback scheduler).
# Use your Supabase project's connection string (Project Settings > Database).
# If unset, falls back to an in-memory job store — fine for local dev, but scheduled
# jobs won't survive a process restart.
DATABASE_URL=

# Models
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_IMAGE_MODEL=gpt-image-2
