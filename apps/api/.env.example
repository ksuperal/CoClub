# LLM
ANTHROPIC_API_KEY=

# Image generation
OPENAI_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# When set, auth verifies the caller's JWT locally (no round-trip to Supabase Auth) --
# only works for a project still on the legacy shared JWT secret (Project Settings >
# API > JWT Secret). Leave unset for a project on the newer asymmetric signing keys;
# every request then falls back to a live Supabase Auth call, same as before.
SUPABASE_JWT_SECRET=

# Browser origins allowed to call this API (comma-separated). Defaults to the local
# frontend; set to the deployed frontend's origin(s) in any non-local environment.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Comma-separated shared keys for machine-to-machine callers (a future second/third
# component), checked against the `X-Service-Key` header. Unused until something
# actually calls in with one -- leave empty for now.
SERVICE_API_KEYS=

# Social posting — direct platform APIs. Leave unset for now and Step 4 will mark
# posts pending_credentials (the pipeline still runs end-to-end). See README.md for
# the manual dashboard steps (Meta Developer App / TikTok Developer App registration,
# scopes, and review/audit process) required before real posting works.

# Meta (Facebook Login for Business) — covers both Facebook Page and Instagram posting
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/social/callback/facebook
# From the app dashboard: Facebook Login for Business > Configurations > Create configuration.
# Required — the OAuth dialog is invoked with this instead of a raw scope list.
META_LOGIN_CONFIG_ID=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/social/callback/tiktok

# Encrypts stored account tokens at rest. Required before any account can be connected.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Where the OAuth callback redirects the browser back to after connecting an account
FRONTEND_URL=http://localhost:3000

# Video generation (Step 2, video campaigns) — image-to-video via Luma's Ray model
# (Luma Agents API). API key from platform.lumalabs.ai (prefixed "luma-api-").
# Leave unset and video campaigns still ideate/review normally, but each variant's
# generation fails cleanly (generation_status = 'failed') instead of crashing.
LUMA_API_KEY=

# Audio (voiceover + background music) for video variants — decided per video
# item during the campaign-scoping conversation, not a campaign-wide toggle at
# intake: background music is added automatically to every video, voiceover
# only if you say yes when the agent explicitly asks. Both voiceover (eleven_v3,
# chosen for expressiveness — OpenAI's TTS read as flat/monotone in testing)
# and music use this one ElevenLabs key from elevenlabs.io. The key needs
# exactly these scopes: Music Generation (Access), Text to Speech (Access),
# Voices (Read) — nothing else. Leave unset and either one just fails cleanly
# per variant (audio_gen_error explains why) instead of blocking the video.
# Mixing/muxing the audio onto the video ALSO requires the `ffmpeg` binary
# installed and on PATH (a system dependency, not a pip package — e.g.
# `winget install ffmpeg` on Windows).
ELEVENLABS_API_KEY=

# Postgres connection string for the durable job store (24hr feedback scheduler).
# Use your Supabase project's connection string (Project Settings > Database).
# If unset, falls back to an in-memory job store — fine for local dev, but scheduled
# jobs won't survive a process restart.
DATABASE_URL=

# Models
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_IMAGE_MODEL=gpt-image-2
