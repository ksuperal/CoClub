# LLM
ANTHROPIC_API_KEY=

# Image generation
OPENAI_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Social posting (leave unset for now — Step 4 will mark posts pending_credentials)
AYRSHARE_API_KEY=

# Postgres connection string for the durable job store (24hr feedback scheduler).
# Use your Supabase project's connection string (Project Settings > Database).
# If unset, falls back to an in-memory job store — fine for local dev, but scheduled
# jobs won't survive a process restart.
DATABASE_URL=

# Models
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_IMAGE_MODEL=gpt-image-2
